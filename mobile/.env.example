# Copy to .env.local, which git ignores. Expo loads it when the dev server starts.

# The Cardano address the wallet shows and claimed NFTs are minted to. This is the server's demo user, who starts
# with three NFTs; any address on the server's network works.
EXPO_PUBLIC_WALLET_ADDRESS=addr_test1vremee8x8n88fhct3qhjg6xwtmvprylzvnww3dy8f7gn8kcfzddd6

# Optional. By default the app looks for the server on port 8787 of the machine running Expo.
# EXPO_PUBLIC_SERVER_URL=http://192.168.1.10:8787
