# Copy to .env.local, which git ignores. Expo loads it when the dev server starts.

# The Cardano address claimed NFTs are minted to. The server prints one when it starts.
EXPO_PUBLIC_WALLET_ADDRESS=

# Optional. By default the app looks for the server on port 8787 of the machine running Expo.
# EXPO_PUBLIC_SERVER_URL=http://192.168.1.10:8787
