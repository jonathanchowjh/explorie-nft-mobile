# Copy to .env.local, which git ignores. Expo loads it when the dev server starts.

# The wallet's key. The app shows its address, has claimed NFTs minted to it, and signs voucher redemptions with it.
# This is the server's demo wallet, which starts with three NFTs. The key ships inside the app, so only ever use a
# testnet key here.
EXPO_PUBLIC_WALLET_KEY=ed25519_sk1a4rftj7hlj80my7equwfedlzu8afjhlpjf5svdvw8ngp6nr25gms0rkak9

# Optional. By default the app looks for the server on port 8787 of the machine running Expo.
# EXPO_PUBLIC_SERVER_URL=http://192.168.1.10:8787
